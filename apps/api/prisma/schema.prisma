generator client {
  provider   = "prisma-client"
  output     = "./generated/prisma"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model Account {
  accountId String   @id @default(dbgenerated("uuid_generate_v4()")) @map("account_id") @db.Uuid
  login     String?  @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)
  name      String?  @db.VarChar(255)
  pseudo    String?  @db.VarChar(255)
  email     String?  @unique @db.VarChar(255)
  isArtist  Boolean  @default(false) @map("is_artist")
  createdAt DateTime? @map("created_at") @db.Timestamp(6)

  artist           Artist?
  preference       Preference?
  preferenceVector PreferenceVector?
  playlistAccounts PlaylistAccount[]
  trackLikes       TrackAccountLike[]
  trackDislikes    TrackAccountDislike[]
  trackListens     TrackAccountListen[]
  trackListenHistoryItems TrackListenHistoryItem[]
  pinnedItems      AccountPinnedItem[]
  trackComments    TrackComment[]

  @@map("account")
}

model Artist {
  artistId              String  @id @map("artist_id") @db.Uuid
  artistBio             String? @map("artist_bio")
  artistMembers         String? @map("artist_members")
  artistImageFile       String? @map("artist_image_file")
  artistImages          String? @map("artist_images")
  artistLocation        String? @map("artist_location")
  artistLatitude        Float?  @map("artist_latitude")
  artistLongitude       Float?  @map("artist_longitude")
  artistActiveYearBegin Int?    @map("artist_active_year_begin")
  artistActiveYearEnd   Int?    @map("artist_active_year_end")
  artistFavorites       BigInt? @map("artist_favorites")
  artistComments        BigInt? @map("artist_comments")

  account      Account             @relation(fields: [artistId], references: [accountId])
  artistTags   ArtistTag[]
  albumArtists AlbumArtist[]
  mainTracks   TrackArtistMain[]
  featTracks   TrackArtistFeat[]
  pinnedItems  AccountPinnedItem[] @relation("PinnedArtist")
  rankArtists  RankArtist[]

  @@map("artist")
}

model Album {
  albumId           String    @id @default(dbgenerated("uuid_generate_v4()")) @map("album_id") @db.Uuid
  albumTitle        String?   @map("album_title")
  albumImageFile    String?   @map("album_image_file")
  albumImages       String?   @map("album_images")
  albumType         String?   @map("album_type") @db.VarChar(255)
  albumTracksCount  Int?      @map("album_tracks_count")
  albumDateReleased DateTime? @map("album_date_released") @db.Date
  albumListens      BigInt?   @map("album_listens")
  albumFavorites    BigInt?   @map("album_favorites")
  albumComments     BigInt?   @map("album_comments")
  albumProducer     String?   @map("album_producer") @db.VarChar(255)

  tracks       Track[]
  albumArtists AlbumArtist[]
  pinnedItems  AccountPinnedItem[] @relation("PinnedAlbum")

  @@map("album")
}

model Genre {
  genreId  String  @id @default(dbgenerated("uuid_generate_v4()")) @map("genre_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  title    String? @db.VarChar(255)
  topLevel Int?    @map("top_level")
  tracksCount Int? @map("tracks_count")

  parent           Genre?            @relation("GenreHierarchy", fields: [parentId], references: [genreId])
  children         Genre[]           @relation("GenreHierarchy")
  trackGenres      TrackGenre[]
  genrePreferences GenrePreference[]

  @@map("genre")
}

model Track {
  trackId           String    @id @default(dbgenerated("uuid_generate_v4()")) @map("track_id") @db.Uuid
  albumId           String?   @map("album_id") @db.Uuid
  trackGenreTop     String?   @map("track_genre_top")
  trackTitle        String?   @map("track_title") @db.VarChar(255)
  trackUrl          String?   @map("track_url")
  trackFile         String?   @map("track_file")
  trackImageFile    String?   @map("track_image_file")
  trackDuration     BigInt?   @map("track_duration")
  trackNumber       Int?      @map("track_number")
  trackDiscNumber   Int?      @map("track_disc_number")
  trackExplicit     Boolean?  @map("track_explicit")
  trackInstrumental Boolean?  @map("track_instrumental")
  trackListens      BigInt?   @map("track_listens")
  trackFavorites    BigInt?   @map("track_favorites")
  trackInterest     Float?    @map("track_interest")
  trackComments     BigInt?   @map("track_comments")
  trackDateCreated  DateTime? @map("track_date_created") @db.Date
  trackComposer     String?   @map("track_composer") @db.VarChar(255)
  trackLyricist     String?   @map("track_lyricist") @db.VarChar(255)
  trackPublisher    String?   @map("track_publisher") @db.VarChar(255)

  album           Album?            @relation(fields: [albumId], references: [albumId])
  audioFeature    AudioFeature?
  temporalFeature TemporalFeature?
  trackGenres     TrackGenre[]
  trackTags       TrackTag[]
  mainArtists     TrackArtistMain[]
  featArtists     TrackArtistFeat[]
  trackLicenses   TrackLicense[]
  playlistTracks  PlaylistTrack[]
  rankTracks      RankTrack[]
  accountLikes    TrackAccountLike[]
  accountDislikes TrackAccountDislike[]
  accountListens  TrackAccountListen[]
  listenHistoryItems TrackListenHistoryItem[]
  pinnedItems     AccountPinnedItem[] @relation("PinnedTrack")
  comments        TrackComment[]

  @@map("track")
}

model AudioFeature {
  trackId          String @id @map("track_id") @db.Uuid
  acousticness     Float? @db.DoublePrecision
  danceability     Float? @db.DoublePrecision
  energy           Float? @db.DoublePrecision
  instrumentalness Float? @db.DoublePrecision
  liveness         Float? @db.DoublePrecision
  speechiness      Float? @db.DoublePrecision
  tempo            Float? @db.DoublePrecision
  valence          Float? @db.DoublePrecision

  track Track @relation(fields: [trackId], references: [trackId])

  @@map("audio_feature")
}

