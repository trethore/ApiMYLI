model TrackListenHistoryItem {
  listenHistoryItemId String   @id @default(dbgenerated("uuid_generate_v4()")) @map("listen_history_item_id") @db.Uuid
  trackId             String   @map("track_id") @db.Uuid
  accountId           String   @map("account_id") @db.Uuid
  listenedAt          DateTime @default(now()) @map("listened_at") @db.Timestamp(6)
  account             Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  track               Track    @relation(fields: [trackId], references: [trackId], onDelete: Cascade)

  @@index([accountId, listenedAt(sort: Desc)])
  @@index([trackId, listenedAt(sort: Desc)])
  @@map("track_listen_history_item")
}

model AccountPinnedItem {
  accountId  String         @map("account_id") @db.Uuid
  slot       Int
  itemType   PinnedItemType @map("item_type")
  trackId    String?        @map("track_id") @db.Uuid
  albumId    String?        @map("album_id") @db.Uuid
  artistId   String?        @map("artist_id") @db.Uuid
  playlistId String?        @map("playlist_id") @db.Uuid
  pinnedAt   DateTime       @default(now()) @map("pinned_at") @db.Timestamp(6)
  account    Account        @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  album      Album?         @relation("PinnedAlbum", fields: [albumId], references: [albumId], onDelete: Cascade)
  artist     Artist?        @relation("PinnedArtist", fields: [artistId], references: [artistId], onDelete: Cascade)
  playlist   Playlist?      @relation("PinnedPlaylist", fields: [playlistId], references: [playlistId], onDelete: Cascade)
  track      Track?         @relation("PinnedTrack", fields: [trackId], references: [trackId], onDelete: Cascade)

  @@id([accountId, slot])
  @@map("account_pinned_item")
}

model TrackComment {
